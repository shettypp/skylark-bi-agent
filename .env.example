# Copy this file to .env.local (for local dev) and fill in real values.
# On your hosting platform (Render/Railway/etc.), set these as environment
# variables in the dashboard instead of committing a .env file.

# monday.com Personal API Token
# Get it from: monday.com -> Avatar (top right) -> Admin/Developers -> API
MONDAY_API_TOKEN=

# Google Gemini API key (free tier, no card required)
# Get it from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: only needed if board auto-discovery by name fails.
# Find these in the board URL: monday.com/boards/<BOARD_ID>
MONDAY_DEALS_BOARD_ID=
MONDAY_WORK_ORDERS_BOARD_ID=

# Optional: port to run the server on locally (hosting platforms usually set this automatically)
PORT=3000
